# OS
.DS_Store

# Local scratch
/tmp/
*.log
coverage.out

# Local environment overrides — .env.sample is the committed template.
.env
.env.local

# Site-specific deploy automation (homelab hostnames, IPs, runbooks).
/deploy.local/

# Personal defense notes (kept out of the public repo).
/docs/reporte-defensa.md

# Branding drafts (LLM prompts, internal aesthetic notes). Final SVG/assets
# under docs/branding/ can still be tracked.
/docs/branding/*.md

# Planning specs and design docs produced during internal brainstorming.
/docs/superpowers/

# Claude Code local skills and project artifacts.
/.claude/

# Source material indexed by the tutor (copyrighted books, etc.). The
# embeddings live in the SQLite under ~/.local/state, not in the repo.
/books/
*.pdf

# Local PoC for tutor experiments. Lives outside the public repo until it
# graduates into a documented surface.
/cmd/modos-tutor-spike/

# State dumps used to seed the RAG corpus on the LXC. Generated by
# deploy.local/v2/export-rag.sh; never commit.
state-dump-*.sql
state-dump-*.db

# Local Claude Code skill artifacts (brainstorm scratchpads, etc.).
.superpowers/

# Local-only workspace (screenshots, scratch notes). Lives on disk but never tracked.
/.local/

# Playwright MCP browser session artifacts (console logs, traces).
/.playwright-mcp/

# Academic paper draft (LaTeX sources, figures, bibliography). Lives in the
# repo for convenience but is not part of the simulator itself.
/paper/
docs/
# Private demo credentials for talks (never commit).
/presentacion/*.local.md
/presentacion/guion-presentacion.md
/presentacion/guion-presentacion-es.md
